{% if entry.publisher %}
  {% capture entrytype %}{{ entrytype }} — {{ entry.publisher }}{% endcapture %}
{% endif %}

{% if entry.location %}
  {% assign first_character = entrytype | strip | slice: 0, 1 %}
  {% if first_character == ',' %}
    {% assign entrytype = entrytype | remove_first: ', ' %}
  {% endif %}
{% endif %}
